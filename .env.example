# Copy this file to .env and fill in real values. Never commit your real .env.

# --- App ---
APP_ENV=development
APP_PORT=8000
# Publicly reachable base URL for this service (used for tracking pixel links
# and approval/reject callback links sent to Telegram/Discord/dashboard).
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database (Postgres) ---
POSTGRES_USER=sdr
POSTGRES_PASSWORD=sdr
POSTGRES_DB=sdr
# Async URL used by the FastAPI app. Celery workers/Alembic derive a
# psycopg2 (sync) URL from this automatically - only set this one.
DATABASE_URL=postgresql+asyncpg://sdr:sdr@postgres:5432/sdr

# --- Redis / Celery (background task queue - replaces the old APScheduler) ---
REDIS_URL=redis://redis:6379/0

# --- LLM provider: "anthropic" or "openai" ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Max steps in the agentic draft -> self-critique -> revise loop for replies.
LLM_AGENTIC_MAX_STEPS=3

# --- Outbound email (SMTP) - default/fallback sender account, seeded into
# the sender_accounts rotation pool on first startup. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_EMAIL=you@example.com
FROM_NAME=Sales Team
# Optional: additional sender accounts for the rotation pool, as a JSON array.
# SENDER_ACCOUNTS_JSON=[{"name":"acct2","provider":"smtp","smtp_host":"smtp.example.com","smtp_port":587,"smtp_username":"u","smtp_password":"p","from_email":"u@example.com","from_name":"Sales","daily_limit":150}]
SENDER_ACCOUNTS_JSON=
# Auto-pause a sender account once its bounce rate crosses this (after at
# least BOUNCE_RATE_MIN_SAMPLE sends, to avoid pausing on one early bounce).
BOUNCE_RATE_PAUSE_THRESHOLD=0.02
BOUNCE_RATE_MIN_SAMPLE=20
# Auto-pause once spam-complaint rate crosses this (same min-sample guard).
SPAM_COMPLAINT_RATE_PAUSE_THRESHOLD=0.001

# --- Inbox warmup: new/reactivated sender accounts ramp daily_limit through
# these stages (one stage per day, via the daily warmup_rotation_task)
# instead of sending at full volume from day one. ---
WARMUP_ENABLED=true
WARMUP_DAILY_TARGETS=10,20,40,80,150,200

# --- Pre-send spam heuristic guardian: every cold email/follow-up is scored
# 0-100 before it can enter the outbound sending queue. >= rewrite threshold
# triggers LLM self-correction rewrite attempts; if still >= flag threshold
# afterward, the message is held as NEEDS_REVIEW instead of sent. ---
SPAM_SCORE_REWRITE_THRESHOLD=40
SPAM_SCORE_FLAG_THRESHOLD=70
SPAM_GUARDIAN_MAX_REWRITE_ATTEMPTS=2

# --- Alternative outreach platform integrations (used if a sender account's
# provider is "instantly"/"smartlead" instead of "smtp") ---
INSTANTLY_API_KEY=
SMARTLEAD_API_KEY=

# --- Inbound email (IMAP) - polled by Celery beat every IMAP_POLL_INTERVAL_SECONDS ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=you@example.com
IMAP_PASSWORD=
IMAP_POLL_INTERVAL_SECONDS=60
IMAP_MAILBOX=INBOX

# --- Follow-up sequence: comma separated day offsets after the initial send ---
FOLLOW_UP_DELAYS_DAYS=3,7

# --- Human-in-the-loop notification channels (configure at least one) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
GENERIC_NOTIFY_WEBHOOK_URL=

# --- Security: admin/dashboard routes accept EITHER header. Leave both
# unset only for local development - the app logs a loud warning if so. ---
ADMIN_API_KEY=
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Username/password to exchange for a JWT via POST /auth/token
ADMIN_USERNAME=
ADMIN_PASSWORD=
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_WEBHOOK=120/minute

# --- CRM integration: Positive/Interested leads are pushed here automatically ---
# "none" or "hubspot"
CRM_PROVIDER=none
# HubSpot private app access token (Settings > Integrations > Private Apps)
HUBSPOT_ACCESS_TOKEN=

# --- Calendar / meeting scheduling ---
# A Cal.com event link or Google Calendar appointment schedule link. Offered
# to prospects whose reply asks to book a call (detected by the LLM).
CALENDAR_BOOKING_URL=https://cal.com/your-team/intro-call

# --- LinkedIn touchpoint automation (profile views / connection requests) ---
# Endpoint for a headless-browser automation layer (PhantomBuster Phantom
# launch webhook, a local Playwright worker's job queue, etc). Left unset,
# LinkedIn steps are safely simulated (logged only) so sequences still work
# end to end without a real automation backend.
LINKEDIN_AUTOMATION_WEBHOOK_URL=
LINKEDIN_AUTOMATION_API_KEY=

# --- Automated lead discovery (see app.services.lead_discovery) ---
# Off by default - explicit opt-in since it spends API credits and creates
# real Lead rows. Business search uses the Google Places API (a legitimate,
# ToS-compliant, rate-limited business directory API - never raw scraping).
LEAD_DISCOVERY_ENABLED=false
GOOGLE_PLACES_API_KEY=
# One discovery pass per entry, once daily at 08:00 UTC (or on demand via
# POST /discovery/run). campaign_name is looked up, or auto-created with a
# single default "A" variant if it doesn't exist yet. Each campaign lists
# several precise, vertical-specific search_queries rather than one broad
# query - results are deduplicated and accumulated across them until
# daily_count unique businesses are found. Tune these to Jeff's actual
# targeting - these are starting points, not final copy.
LEAD_DISCOVERY_CAMPAIGNS_JSON=[{"campaign_name":"FFY","daily_count":25,"search_queries":["full-service restaurants","bars and pubs","cafes and coffee shops","breweries and taprooms","nightclubs and lounges"]},{"campaign_name":"Tip Tax Refund","daily_count":25,"search_queries":["full-service restaurants with table service","bars and nightclubs","hotel restaurants and room service","casino dining and bars","banquet halls and event catering venues"]}]
# Owner-contact enrichment is NEVER fabricated - a business with no real
# contact found via this provider is skipped, not guessed at. Point this at
# your own contracted data provider (Hunter.io, Apollo, Clearbit, an
# internal database, etc.) - it receives {name, address, website, phone}
# and must return {} or {"contact_name","email","linkedin_url"}. Left
# unset, every discovered business is skipped (0 leads created, logged).
CONTACT_ENRICHMENT_WEBHOOK_URL=
CONTACT_ENRICHMENT_API_KEY=
