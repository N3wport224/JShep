# Copy this file to .env and fill in real values. Never commit your real .env.

# --- App ---
APP_ENV=development
APP_PORT=8000
# Publicly reachable base URL for this service (used for tracking pixel links
# and approval/reject callback links sent to Telegram/Discord/dashboard).
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database (Postgres) ---
POSTGRES_USER=sdr
POSTGRES_PASSWORD=sdr
POSTGRES_DB=sdr
# Async URL used by the FastAPI app. Celery workers/Alembic derive a
# psycopg2 (sync) URL from this automatically - only set this one.
DATABASE_URL=postgresql+asyncpg://sdr:sdr@postgres:5432/sdr

# --- Redis / Celery (background task queue - replaces the old APScheduler) ---
REDIS_URL=redis://redis:6379/0

# --- LLM provider: "anthropic" or "openai" ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Max steps in the agentic draft -> self-critique -> revise loop for replies.
LLM_AGENTIC_MAX_STEPS=3

# --- Outbound email (SMTP) - default/fallback sender account, seeded into
# the sender_accounts rotation pool on first startup. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_EMAIL=you@example.com
FROM_NAME=Sales Team
# Optional: additional sender accounts for the rotation pool, as a JSON array.
# SENDER_ACCOUNTS_JSON=[{"name":"acct2","provider":"smtp","smtp_host":"smtp.example.com","smtp_port":587,"smtp_username":"u","smtp_password":"p","from_email":"u@example.com","from_name":"Sales","daily_limit":150}]
SENDER_ACCOUNTS_JSON=
# Auto-pause a sender account once its bounce rate crosses this (after at
# least BOUNCE_RATE_MIN_SAMPLE sends, to avoid pausing on one early bounce).
BOUNCE_RATE_PAUSE_THRESHOLD=0.05
BOUNCE_RATE_MIN_SAMPLE=20

# --- Alternative outreach platform integrations (used if a sender account's
# provider is "instantly"/"smartlead" instead of "smtp") ---
INSTANTLY_API_KEY=
SMARTLEAD_API_KEY=

# --- Inbound email (IMAP) - polled by Celery beat every IMAP_POLL_INTERVAL_SECONDS ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=you@example.com
IMAP_PASSWORD=
IMAP_POLL_INTERVAL_SECONDS=60
IMAP_MAILBOX=INBOX

# --- Follow-up sequence: comma separated day offsets after the initial send ---
FOLLOW_UP_DELAYS_DAYS=3,7

# --- Human-in-the-loop notification channels (configure at least one) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
GENERIC_NOTIFY_WEBHOOK_URL=

# --- Security: admin/dashboard routes accept EITHER header. Leave both
# unset only for local development - the app logs a loud warning if so. ---
ADMIN_API_KEY=
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Username/password to exchange for a JWT via POST /auth/token
ADMIN_USERNAME=
ADMIN_PASSWORD=
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_WEBHOOK=120/minute
